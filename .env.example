# Tool Version Audit & Notification System Configuration
# Copy this file to .env and update with your settings

# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=False
PORT=5000

# Email Configuration (Required for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@company.com
SENDER_PASSWORD=your-app-password
SENDER_NAME=Tool Version Monitor

# Database Configuration
DATABASE_PATH=data/tool_versions.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=data/daily_check.log

# Version Check Configuration
CHECK_INTERVAL_HOURS=24
NOTIFICATION_RETRY_HOURS=4

# System Configuration
MAX_SUBMISSIONS_PER_EMAIL=10
DATA_RETENTION_DAYS=365